<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --color-bg: #f3f4f6;
        --color-surface: #ffffff;
        --color-panel: #f8fafc;
        --color-border: #d9dee8;
        --color-text: #111827;
        --color-muted: #667085;
        --color-accent: #2563eb;
        --color-accent-hover: #1d4ed8;
        --color-danger: #dc2626;
        --color-success: #16a34a;
        --color-warning: #b45309;
        --sp-1: 0.25rem;
        --sp-2: 0.5rem;
        --sp-3: 0.75rem;
        --sp-4: 1rem;
        --sp-5: 1.25rem;
        --sp-6: 1.5rem;
        --sp-8: 2rem;
        --r-sm: 4px;
        --r-md: 8px;
        --r-lg: 12px;
        --r-full: 9999px;
        --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06);
        --shadow-md: 0 14px 40px rgba(15, 23, 42, 0.08);
        --font-sans: "Inter", system-ui, sans-serif;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        -webkit-text-size-adjust: 100%;
      }

      body {
        min-height: 100vh;
        font-family: var(--font-sans);
        line-height: 1.5;
        color: var(--color-text);
        background: var(--color-bg);
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      input, button {
        font: inherit;
      }

      .topbar {
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-4);
        padding: 0 clamp(var(--sp-4), 5vw, var(--sp-8));
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        box-shadow: var(--shadow-sm);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: var(--sp-3);
        min-width: 0;
      }

      .brand-mark {
        width: 40px;
        height: 40px;
        display: inline-grid;
        place-items: center;
        border-radius: var(--r-md);
        background: var(--color-accent);
        color: #ffffff;
        font-weight: 800;
      }

      .brand-title {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--sp-3);
      }

      .brand-title strong {
        color: var(--color-accent);
        font-size: 1.5rem;
        line-height: 1.1;
      }

      .brand-title span,
      .operator {
        color: var(--color-muted);
        font-size: 0.9375rem;
      }

      .operator {
        white-space: nowrap;
      }

      .shell {
        width: min(1280px, calc(100vw - 32px));
        margin: var(--sp-6) auto;
        display: grid;
        grid-template-columns: minmax(340px, 0.9fr) minmax(0, 1.35fr);
        gap: var(--sp-6);
      }

      .panel {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--r-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
      }

      .panel-header {
        padding: var(--sp-6);
        border-bottom: 1px solid var(--color-border);
      }

      .panel-body {
        padding: var(--sp-6);
      }

      .kicker {
        color: var(--color-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0;
      }

      h1 {
        margin-top: var(--sp-2);
        font-size: 1.75rem;
        line-height: 1.2;
      }

      h2 {
        font-size: 1.125rem;
        line-height: 1.3;
      }

      .header-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--sp-4);
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2);
        padding: 0.25rem var(--sp-3);
        border-radius: var(--r-full);
        font-size: 0.8125rem;
        font-weight: 700;
        white-space: nowrap;
      }

      .badge::before {
        content: "";
        width: 0.5rem;
        height: 0.5rem;
        border-radius: var(--r-full);
        background: currentColor;
      }

      .badge.pending {
        color: var(--color-warning);
        background: #fef3c7;
      }

      .badge.success {
        color: var(--color-success);
        background: #dcfce7;
      }

      .badge.failed,
      .badge.cancelled,
      .badge.expired {
        color: var(--color-danger);
        background: #fee2e2;
      }

      .amount {
        margin-top: var(--sp-4);
        color: var(--color-accent);
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.1;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sp-3);
        margin-top: var(--sp-5);
      }

      .info-cell,
      .receiver,
      .signature-box,
      .account-card,
      .notice {
        border: 1px solid var(--color-border);
        border-radius: var(--r-md);
        background: var(--color-panel);
      }

      .info-cell {
        padding: var(--sp-4);
        min-width: 0;
      }

      .label {
        display: block;
        color: var(--color-muted);
        font-size: 0.8125rem;
        font-weight: 500;
        margin-bottom: var(--sp-1);
      }

      .value {
        color: var(--color-text);
        font-size: 0.9375rem;
        font-weight: 700;
        overflow-wrap: anywhere;
      }

      .qr-wrap {
        display: grid;
        place-items: center;
        padding: var(--sp-5);
        border: 1px dashed #b8c2d6;
        border-radius: var(--r-lg);
        background: #ffffff;
      }

      .qr-wrap img {
        width: min(260px, 100%);
        height: auto;
      }

      .receiver,
      .signature-box,
      .notice {
        padding: var(--sp-4);
        margin-top: var(--sp-4);
      }

      .receiver-title,
      .section-title {
        display: flex;
        align-items: center;
        gap: var(--sp-2);
        margin-bottom: var(--sp-3);
      }

      .section-title::before {
        content: "";
        width: 4px;
        height: 1.5rem;
        border-radius: var(--r-full);
        background: var(--color-accent);
      }

      .stack {
        display: grid;
        gap: var(--sp-3);
      }

      .section-gap {
        margin-top: var(--sp-6);
      }

      .signature-box code {
        display: block;
        color: var(--color-muted);
        font-size: 0.8125rem;
        line-height: 1.6;
        overflow-wrap: anywhere;
      }

      .account-list {
        display: grid;
        gap: var(--sp-3);
      }

      .account-card {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: var(--sp-3);
        padding: var(--sp-4);
        cursor: pointer;
        transition: border-color 150ms ease, background 150ms ease;
      }

      .account-card:has(input:checked) {
        border-color: var(--color-accent);
        background: #eff6ff;
      }

      .account-card input {
        width: 18px;
        height: 18px;
        margin-top: 2px;
        accent-color: var(--color-accent);
      }

      .account-main {
        min-width: 0;
      }

      .account-name {
        display: block;
        font-weight: 700;
      }

      .account-meta,
      .account-balance,
      .countdown {
        color: var(--color-muted);
        font-size: 0.875rem;
      }

      .countdown {
        margin-top: var(--sp-3);
        font-weight: 600;
      }

      .countdown.expired {
        color: var(--color-danger);
      }

      .actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: var(--sp-3);
        margin-top: var(--sp-6);
        padding-top: var(--sp-5);
        border-top: 1px solid var(--color-border);
      }

      .btn {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--sp-2);
        padding: var(--sp-3) var(--sp-5);
        border: 1px solid transparent;
        border-radius: var(--r-md);
        font-size: 0.9375rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 150ms ease, border-color 150ms ease;
        white-space: nowrap;
      }

      .btn-primary {
        color: #ffffff;
        background: var(--color-accent);
      }

      .btn-primary:hover {
        background: var(--color-accent-hover);
      }

      .btn-outline {
        color: var(--color-text);
        background: #ffffff;
        border-color: var(--color-border);
      }

      .btn-outline:hover {
        border-color: var(--color-danger);
        color: var(--color-danger);
      }

      .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
      }

      .notice {
        color: #92400e;
        background: #fffbeb;
      }

      @media (max-width: 960px) {
        .shell {
          grid-template-columns: 1fr;
        }

        .operator {
          display: none;
        }
      }

      @media (max-width: 620px) {
        .topbar {
          align-items: flex-start;
          padding-top: var(--sp-4);
          padding-bottom: var(--sp-4);
        }

        .brand-title {
          display: grid;
          gap: var(--sp-1);
        }

        .brand-title strong {
          font-size: 1.25rem;
        }

        .shell {
          width: min(100vw - 20px, 1280px);
          margin: var(--sp-3) auto;
          gap: var(--sp-3);
        }

        .panel-header,
        .panel-body {
          padding: var(--sp-4);
        }

        .header-row,
        .actions {
          align-items: stretch;
          flex-direction: column;
        }

        .info-grid {
          grid-template-columns: 1fr;
        }

        .btn {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <%
      const statusKey = String(payment.status || 'PENDING').toLowerCase();
      const statusLabels = {
        PENDING: 'Cho thanh toan',
        SUCCESS: 'Da thanh toan',
        FAILED: 'Da tu choi',
        CANCELLED: 'Da huy',
        EXPIRED: 'Het han',
      };
      const isPending = payment.status === 'PENDING';
      const hasAccounts = Array.isArray(mockAccounts) && mockAccounts.length > 0;
    %>
    <header class="topbar">
      <div class="brand">
        <span class="brand-mark">V</span>
        <div class="brand-title">
          <strong>VeriPay Verify</strong>
          <span>Cong xac thuc thanh toan ve</span>
        </div>
      </div>
      <div class="operator">Gateway Operator</div>
    </header>

    <main class="shell">
      <aside class="panel">
        <div class="panel-header">
          <div class="header-row">
            <div>
              <span class="kicker">Yeu cau thanh toan</span>
              <h1><%= payment.paymentId %></h1>
            </div>
            <span class="badge <%= statusKey %>">
              <%= statusLabels[payment.status] || payment.status %>
            </span>
          </div>
          <div class="amount">
            <%= Number(payment.amount).toLocaleString('vi-VN') %> <%= payment.currency %>
          </div>
        </div>

        <div class="panel-body">
          <div class="qr-wrap">
            <img src="<%= qrCodeDataUrl %>" alt="QR thanh toan VeriPay" width="260" height="260" />
          </div>

          <p class="countdown" id="countdown" data-expired-at="<%= new Date(payment.expiredAt).toISOString() %>">
            Dang tinh thoi gian con lai...
          </p>

          <section class="receiver">
            <div class="receiver-title">
              <h2>Tai khoan nhan</h2>
            </div>
            <div class="stack">
              <div>
                <span class="label">Ngan hang</span>
                <span class="value"><%= payment.receiverBankCode %></span>
              </div>
              <div>
                <span class="label">So tai khoan</span>
                <span class="value"><%= payment.receiverAccountNumber %></span>
              </div>
              <div>
                <span class="label">Chu tai khoan</span>
                <span class="value"><%= payment.receiverAccountName %></span>
              </div>
            </div>
          </section>
        </div>
      </aside>

      <section class="panel">
        <div class="panel-header">
          <div class="header-row">
            <div>
              <span class="kicker">Chi tiet xac thuc</span>
              <h1>Thanh toan booking</h1>
            </div>
          </div>
          <div class="info-grid">
            <div class="info-cell">
              <span class="label">bookingId</span>
              <span class="value"><%= payment.bookingId %></span>
            </div>
            <div class="info-cell">
              <span class="label">Het han</span>
              <span class="value"><%= new Date(payment.expiredAt).toLocaleString('vi-VN') %></span>
            </div>
            <div class="info-cell">
              <span class="label">Giao dich gateway</span>
              <span class="value"><%= payment.transactionCode || '-' %></span>
            </div>
            <div class="info-cell">
              <span class="label">Callback da gui</span>
              <span class="value"><%= payment.callbackAttempts || 0 %> lan</span>
            </div>
          </div>
        </div>

        <div class="panel-body">
          <section>
            <div class="section-title">
              <h2>HMAC va callback</h2>
            </div>
            <div class="signature-box">
              <code>callbackUrl=<%= payment.callbackUrl %></code>
              <code>returnUrl=<%= payment.returnUrl %></code>
            </div>
          </section>

          <form method="post" action="/gateway/pay/<%= payment.paymentId %>/action">
            <section class="section-gap">
              <div class="section-title">
                <h2>Tai khoan chuyen tien mock</h2>
              </div>

              <% if (!hasAccounts) { %>
                <div class="notice">
                  Chua co tai khoan mock kha dung trong fake gateway.
                </div>
              <% } else { %>
                <div class="account-list">
                  <% mockAccounts.forEach((account, index) => { %>
                    <label class="account-card">
                      <input
                        type="radio"
                        name="payerAccountNumber"
                        value="<%= account.accountNumber %>"
                        <%= index === 0 ? 'checked' : '' %>
                        <%= !isPending ? 'disabled' : '' %>
                      />
                      <span class="account-main">
                        <span class="account-name"><%= account.accountName %></span>
                        <span class="account-meta">
                          <%= account.bankCode %> - <%= account.accountNumber %>
                        </span>
                        <span class="account-balance">
                          So du: <%= Number(account.balance).toLocaleString('vi-VN') %> VND
                        </span>
                      </span>
                    </label>
                  <% }) %>
                </div>
              <% } %>
            </section>

            <% if (payment.failureReason) { %>
              <div class="notice">
                Ly do: <%= payment.failureReason %>
              </div>
            <% } %>

            <div class="actions">
              <button
                class="btn btn-outline"
                type="submit"
                name="action"
                value="FAILED"
                <%= !isPending ? 'disabled' : '' %>
              >
                Tu choi
              </button>
              <button
                class="btn btn-primary"
                type="submit"
                name="action"
                value="SUCCESS"
                <%= !isPending || !hasAccounts ? 'disabled' : '' %>
              >
                Xac thuc thanh toan
              </button>
            </div>
          </form>
        </div>
      </section>
    </main>

    <script>
      (function () {
        const countdownElement = document.getElementById('countdown');

        if (!countdownElement) {
          return;
        }

        const expiredAt = new Date(countdownElement.dataset.expiredAt).getTime();

        const render = () => {
          const diff = expiredAt - Date.now();

          if (diff <= 0) {
            countdownElement.textContent = 'Thanh toan da het han.';
            countdownElement.classList.add('expired');
            return;
          }

          const totalSeconds = Math.floor(diff / 1000);
          const minutes = String(Math.floor(totalSeconds / 60)).padStart(2, '0');
          const seconds = String(totalSeconds % 60).padStart(2, '0');

          countdownElement.textContent = 'Con lai ' + minutes + ':' + seconds + ' de thanh toan.';
        };

        render();
        window.setInterval(render, 1000);
      })();
    </script>
  </body>
</html>
